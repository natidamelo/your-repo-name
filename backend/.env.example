# Secret key for JWT token generation
SECRET_KEY=super-secret-call-center-key-2026-production

# Database URL:
# For local SQLite (default zero-config):
# DATABASE_URL=sqlite:///./callcenter.db
#
# For Render PostgreSQL (automatically provided by Render if using Render Postgres):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./callcenter.db
